{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "nodeModulesDir": "auto",
  "workspace": ["./supabase"],
  "compilerOptions": {
    "allowSloppyImport": true,
    "esModuleInterop": true
  },
  "allowScripts": [
    "npm:@parcel/watcher@2.5.6",
    "npm:@sentry/cli@1.77.3",
    "npm:@sentry/cli@3.4.2",
    "npm:esbuild@0.23.1",
    "npm:esbuild@0.24.0",
    "npm:sqlite3@5.1.7"
  ],
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 128,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "exclude": ["no-sloppy-imports"]
    }
  }
}
